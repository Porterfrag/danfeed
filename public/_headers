# Cloudflare Pages headers.
#
# Vite fingerprints every filename under /assets, so those can be cached forever:
# a new build produces new names rather than overwriting old ones.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The app shell must always revalidate, otherwise a deploy would not be picked up
# until the cached HTML expired.
/
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate

# Brand assets keep stable names (index.html and the manifest point at fixed paths),
# so they get a day rather than the immutable /assets rule. Replace an icon and it
# can take a day for every visitor to see it.
/favicon-32.png
  Cache-Control: public, max-age=86400

/apple-touch-icon.png
  Cache-Control: public, max-age=86400

/icon-*.png
  Cache-Control: public, max-age=86400

# The link-preview card keeps its name too, and crawlers are the least tolerant of a slow first
# fetch there is.
/og.png
  Cache-Control: public, max-age=86400

/manifest.webmanifest
  Cache-Control: public, max-age=86400

# Baseline hardening.
#
# Deliberately no Content-Security-Policy: the app pulls images and video from
# cdn.donmai.us and embeds YouTube/Vimeo iframes, so a restrictive policy needs
# to be written and tested against those origins rather than guessed at.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
